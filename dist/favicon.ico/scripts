import { spawn } from 'node:child_process'
import process from 'node:process'
import { fileURLToPath } from 'node:url'
import { dirname, join } from 'node:path'
import fs from 'node:fs'

const node = process.execPath
const root = dirname(dirname(fileURLToPath(import.meta.url)))
const viteBin = join(root, 'node_modules', 'vite', 'bin', 'vite.js')
const backend = join(root, 'backend', 'Server.js')

if (!fs.existsSync(backend)) {
  console.error(`Backend file not found: ${backend}`)
  process.exit(1)
}
if (!fs.existsSync(viteBin)) {
  console.error('Vite is not installed. Run npm install in the folder containing package.json, then npm run dev.')
  process.exit(1)
}

console.log('Starting PAP\'s Jolo Studio...')
console.log(`Backend: ${backend}`)
console.log(`Frontend: ${viteBin}`)

const processes = [
  spawn(node, [backend], { cwd: root, stdio: 'inherit', env: { ...process.env } }),
  spawn(node, [viteBin], { cwd: root, stdio: 'inherit', env: { ...process.env } }),
]

let stopping = false
const stop = () => {
  if (stopping) return
  stopping = true
  processes.forEach((child) => {
    if (!child.killed) child.kill()
  })
}

process.on('SIGINT', stop)
process.on('SIGTERM', stop)
process.on('exit', stop)

processes.forEach((child, index) => {
  child.on('error', (error) => {
    console.error(index === 0 ? 'Backend failed to start:' : 'Frontend failed to start:', error.message)
  })
  child.on('exit', (code) => {
    if (!stopping && code !== 0) {
      console.error(index === 0 ? `Backend stopped with code ${code}.` : `Frontend stopped with code ${code}.`)
    }
  })
})
